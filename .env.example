# Server-only secrets
# DATABASE_URL and POSTGRESQL are accepted aliases; set one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
OPENROUTER_API_KEY=replace-with-openrouter-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Vercel Sandbox: enable OIDC in Vercel production. For local development use
# `vercel link` + `vercel env pull`. The three values below are only the fallback
# for environments where OIDC is unavailable; if VERCEL_TOKEN is set, all three
# values are required.
VERCEL_TEAM_ID=replace-with-vercel-team-id
VERCEL_PROJECT_ID=replace-with-vercel-project-id
VERCEL_TOKEN=replace-with-vercel-access-token

# Server configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL and OPENROUTER_MODEL are accepted aliases; set one.
OPENROUTER_DEFAULT_MODEL=replace-with-openrouter-model-id
# Required outside Vercel. Use only the origin, without a path or trailing slash.
APP_URL=https://your-app.example.com

# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
